# Copiar este archivo como .env y completar. El archivo .env NUNCA se comparte ni se sube a git.

# --- Modelos: elegir backend para puntuar y para redactar ---
# "ollama" = local y gratis · "groq" = API con plan gratis (sin GPU propia) · "claude" = mejor calidad, de pago
# El *_FALLBACK se usa si el principal no está disponible o falla ("skip" = ninguno).
SCORER_BACKEND=ollama
SCORER_FALLBACK=skip
WRITER_BACKEND=ollama
WRITER_FALLBACK=skip

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Modelo local para redactar (vacío = el mismo de OLLAMA_MODEL). Ej: qwen3:14b redacta mejor (~9 GB RAM)
OLLAMA_WRITER_MODEL=

# --- Groq (API key gratis en console.groq.com, con correo personal) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Opcionales: modelo distinto para puntuar o redactar (vacío = GROQ_MODEL)
GROQ_SCORER_MODEL=
GROQ_WRITER_MODEL=

# --- Claude (solo si algún backend o fallback es "claude") ---
ANTHROPIC_API_KEY=
CLAUDE_WRITER_MODEL=claude-sonnet-5-5
# Tope de gasto mensual que el propio agente respeta (además del tope en la consola)
MONTHLY_BUDGET_USD=10
# Máximo de propuestas que redacta por corrida
MAX_PROPOSALS_PER_RUN=5

# --- Correo dedicado para alertas de Upwork / Workana (Gmail + contraseña de aplicación) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Freelancer.com (API oficial, token personal) ---
FREELANCER_TOKEN=

# --- Agente de tasa EUR → COP ---
# Monto típico que compras, para calcular el ahorro frente al promedio
FX_MONTO_EUR=1000
# Avisar si la tasa de mercado baja de este valor (COP por 1 EUR). 0 = sin umbral
FX_ALERTA_EUR_COP=0

# --- Avisos por Telegram (crear bot con @BotFather; chat_id con @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Agente empleo (España) ---
# Modelo propio para puntuar empleo (vacío = SCORER_BACKEND). Ej: groq con respaldo local
EMPLEO_SCORER_BACKEND=groq
EMPLEO_SCORER_FALLBACK=ollama
# Adzuna: clave gratis en developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# InfoJobs: registrar una app en developer.infojobs.net (con tu cuenta personal de InfoJobs)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
# Las alertas de LinkedIn / Indeed / Tecnoempleo / InfoJobs llegan al correo de IMAP_USER (arriba)
